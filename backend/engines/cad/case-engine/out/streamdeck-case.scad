// keeberia-streamdeck — case
// generated by keeberia from the project model. edit any parameter
// below and re-render: the model is parametric and dependency-free
// (vanilla openscad, no libraries). coordinates match the pcb's board
// coordinates: (0,0) is the board center, +y is toward the usb wall.

// ── parameters (these are the app's sliders) ─────────────────
pcb_width      = 89.75;  // from the generated board
pcb_height     = 92.45;
pcb_thickness  = 1.6;    // 2-layer, 1.6mm fr4
pcb_corner_radius = 2.5;
case_margin    = 1.6;     // pcb edge to inner wall (print tolerance)
wall_thickness = 3;     // side walls
base_thickness = 2.4;     // case floor
corner_radius   = 4;     // outer corner radius
front_height   = 10;     // wall height, usb edge
rear_height    = 10;     // wall height, far edge
standoff_height = 5;     // pcb floats this far above the floor
screw_size     = 2.2;    // m2 drill
plate_thickness = 1.5;    // switch plate (mx 1.5, choc 1.2)
$fn = 48;

// ── derived from the board (regenerate the case to change these) ──
usb_slot_width  = 10.6;   // xiao usb-c shell + clearance
usb_slot_z     = [2.54, 7];
usb_slot_along = -5.2;   // usb-c center along the front (+y) wall
screw_hole     = screw_size + 0.2;
standoff_radius = screw_size / 2 + 2.5;

// rounded rectangle, hull of four circles — no libraries needed
module rounded_rect(width, depth, radius) {
  r = max(radius, 0.01);
  hull()
    for (x = [-(width / 2 - r), width / 2 - r])
      for (y = [-(depth / 2 - r), depth / 2 - r])
        translate([x, y, 0]) circle(r);
}

cavity_width  = pcb_width + 2 * case_margin;
cavity_height = pcb_height + 2 * case_margin;
outer_width   = cavity_width + 2 * wall_thickness;
outer_height  = cavity_height + 2 * wall_thickness;
wall_height   = max(front_height, rear_height);

// the tray: floor + walls, hollow above the floor, open top
module case_body() {
  difference() {
    linear_extrude(wall_height)
      rounded_rect(outer_width, outer_height, corner_radius);
    translate([0, 0, base_thickness])
      linear_extrude(wall_height)
        rounded_rect(cavity_width, cavity_height, corner_radius - wall_thickness);
  }
}

// pcb anchors: posts under the board's mounting holes
module standoff(x, y) {
  translate([x, y, base_thickness])
    difference() {
      cylinder(h = standoff_height, r = standoff_radius);
      translate([0, 0, -1]) cylinder(h = standoff_height + 2, r = screw_hole / 2);
    }
}
module standoffs() {
  standoff(-41.37, -42.72);  // H1
  standoff(41.38, -42.72);  // H2
  standoff(-41.37, 42.73);  // H3
  standoff(41.38, 42.73);  // H4
}

// usb-c slot, cut through the front (+y) wall
module usb_slot() {
  translate([usb_slot_along - usb_slot_width / 2, cavity_height / 2 - 1, usb_slot_z[0] - 0.5])
    cube([usb_slot_width, wall_thickness + 2, usb_slot_z[1] - usb_slot_z[0] + 1]);
}

module case_bottom() {
  difference() {
    union() {
      case_body();
      standoffs();
    }
    usb_slot();
  }
}

// the switch plate: sits on the wall tops, keys + knobs + display poke through
module top_plate() {
  difference() {
    linear_extrude(plate_thickness)
      rounded_rect(outer_width, outer_height, corner_radius);
    translate([-40.78, -31.72, -1])
      cube([14, 14, plate_thickness + 2]);  // SW1
    translate([-21.72, -31.72, -1])
      cube([14, 14, plate_thickness + 2]);  // SW2
    translate([-40.78, -12.67, -1])
      cube([14, 14, plate_thickness + 2]);  // SW3
    translate([-21.72, -12.67, -1])
      cube([14, 14, plate_thickness + 2]);  // SW4
    translate([-2.68, -12.67, -1])
      cube([14, 14, plate_thickness + 2]);  // SW5
    translate([16.38, -12.67, -1])
      cube([14, 14, plate_thickness + 2]);  // SW6
    translate([-40.78, 6.38, -1])
      cube([14, 14, plate_thickness + 2]);  // SW7
    translate([-21.72, 6.38, -1])
      cube([14, 14, plate_thickness + 2]);  // SW8
    translate([-2.68, 6.38, -1])
      cube([14, 14, plate_thickness + 2]);  // SW9
    translate([16.38, 6.38, -1])
      cube([14, 14, plate_thickness + 2]);  // SW10
    translate([4.32, -24.72, -1])
      cylinder(h = plate_thickness + 2, d = 10);  // ENC1 knob shaft
    translate([10.38, -28.72, -1])
      cube([26, 8, plate_thickness + 2]);  // OLED1 window
    translate([-41.37, -42.72, -1])
      cylinder(h = plate_thickness + 2, d = screw_hole);  // H1
    translate([41.38, -42.72, -1])
      cylinder(h = plate_thickness + 2, d = screw_hole);  // H2
    translate([-41.37, 42.73, -1])
      cylinder(h = plate_thickness + 2, d = screw_hole);  // H3
    translate([41.38, 42.73, -1])
      cylinder(h = plate_thickness + 2, d = screw_hole);  // H4
  }
}

// ── parts: print both, they sit side by side in this render ──────
case_bottom();
translate([outer_width / 2 + 15, 0, 0]) top_plate();
